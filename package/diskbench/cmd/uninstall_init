#!/bin/bash

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)" || exit 1

uninstall_error() {
  printf '%s\n' "$1" >&2
  [ -z "${TRIM_TEMP_LOGFILE:-}" ] || printf '%s\n' "$1" > "$TRIM_TEMP_LOGFILE"
  return 1
}

# Missing wizard values (for example a CLI uninstall) preserve history by default.
case "${wizard_history_action:-keep}" in
  keep|delete) ;;
  *) uninstall_error "请选择保留或删除历史记录。"; exit 1 ;;
esac

# Finish persisting interrupted task state. fnOS retains var; an explicit
# deletion is handled later in uninstall_callback, after package removal.
if ! bash "$SCRIPT_DIR/main" stop; then
  uninstall_error "应用服务尚未停止，请等待磁盘 I/O 或固件自检中止完成后重试卸载。"
  exit 1
fi
bash "$SCRIPT_DIR/main" status
status=$?
if [ "$status" != 3 ]; then
  uninstall_error "应用服务尚未停止，请停止扫描与测速后重试卸载。"
  exit 1
fi

exit 0
