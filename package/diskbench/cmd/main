#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/app.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
SOCKET_PATH="${TRIM_APPDEST}/app.sock"
APP_DIR="${TRIM_APPDEST}/server"

# Prefer architecture-matched tools shipped in the FPK. The base fnOS tools
# remain available as a fallback for lsblk, findmnt, dd and fstrim.
export PATH="${APP_DIR}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

is_running() {
  [ -f "$PID_FILE" ] || return 1
  pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
  [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  # A stale PID can belong to another service after a restart. Signal only our
  # binary; zombies have no executable link and are already stopped.
  process_exe="$(readlink -- "/proc/$pid/exe" 2>/dev/null)" || return 1
  expected_exe="$(realpath -m -- "$APP_DIR/diskbench")" || return 1
  [ "${process_exe% (deleted)}" = "$expected_exe" ]
}

start_app() {
  if is_running; then
    return 0
  fi
  mkdir -p "$TRIM_PKGVAR"
  rm -f "$PID_FILE" "$SOCKET_PATH"
  cd "$APP_DIR" || return 1
  chmod 0755 ./diskbench 2>/dev/null || true
  if [ -d ./bin ]; then
    chmod 0755 ./bin/* 2>/dev/null || true
  fi
  umask 007
  LOCAL_DEV=0 MOCK_DEV=0 DATA_DIR="$TRIM_PKGVAR" GATEWAY_PREFIX="/app/diskbench" SOCKET_PATH="$SOCKET_PATH" \
    ./diskbench >> "$LOG_FILE" 2>&1 &
  echo "$!" > "$PID_FILE"
}

stop_app() {
  if ! is_running; then
    rm -f "$PID_FILE" "$SOCKET_PATH"
    return 0
  fi
  pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
  kill -TERM "$pid" 2>> "$LOG_FILE" || true
  count=0
  while is_running && [ "$count" -lt 10 ]; do
    sleep 1
    count=$((count + 1))
  done
  if is_running; then
    # fnOS may stop the app before uninstall_init. Keep the same graceful
    # behavior there so pending disk I/O / self-test aborts can finish safely.
    message="应用仍在等待磁盘 I/O 或固件自检中止完成，请稍后重试停止或卸载。"
    printf '%s\n' "$message" >&2
    [ -z "${TRIM_TEMP_LOGFILE:-}" ] || printf '%s\n' "$message" > "$TRIM_TEMP_LOGFILE"
    return 1
  fi
  rm -f "$PID_FILE" "$SOCKET_PATH"
}

case "$1" in
  start) start_app ;;
  stop) stop_app ;;
  status) is_running && exit 0 || exit 3 ;;
  *) echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"; exit 1 ;;
esac
